Options -Indexes
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|json|wasm)$">
    Header unset Expires
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
<Files "index.html">
  Require all denied
</Files>
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
